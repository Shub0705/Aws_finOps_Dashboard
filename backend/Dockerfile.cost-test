
FROM python:3.12-slim

ARG APP_UID=1000
ARG APP_GID=1000

RUN groupadd --gid ${APP_GID} appuser && \
    useradd --uid ${APP_UID} \
            --gid ${APP_GID} \
            --create-home \
            --shell /usr/sbin/nologin \
            appuser

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

COPY requirements.txt requirements-cost-management.txt ./

RUN pip install --no-cache-dir \
    -r requirements.txt \
    -r requirements-cost-management.txt

COPY --chown=appuser:appuser app ./app

RUN mkdir -p /home/appuser/.aws && \
    chown -R appuser:appuser /home/appuser/.aws

USER appuser

EXPOSE 8000

CMD ["uvicorn", "app.cost_test_main:app", "--host", "0.0.0.0", "--port", "8000"]

